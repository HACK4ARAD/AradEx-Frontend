VITE_API_URL=http://localhost:8080/api/v1
VITE_DEMO=true
# T08: cheia de browser Google Maps (Maps JavaScript API). Fără ea, harta folosește rezerva Leaflet.
# Pune-o în .env.local (ignorat de git), niciodată aici.
VITE_GOOGLE_MAPS_KEY=
# opțional: Map ID din Google Cloud (stil hartă); implicit DEMO_MAP_ID
VITE_GOOGLE_MAPS_MAP_ID=

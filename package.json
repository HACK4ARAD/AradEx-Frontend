{
  "name": "aradexperience-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:mobile": "vite --mode mobile",
    "build": "vue-tsc -b && vite build",
    "build:mobile": "vue-tsc -b && vite build --mode mobile",
    "check:web": "node scripts/check-web-build.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "lint": "vue-tsc --noEmit -p tsconfig.app.json",
    "cap:sync": "npm run build:mobile && cap sync android",
    "android:run": "npm run cap:sync && cap run android",
    "android:open": "cap open android",
    "ios:sync": "npm run build:mobile && cap sync ios",
    "ios:open": "cap open ios"
  },
  "dependencies": {
    "@capacitor/android": "^6.2.3",
    "@capacitor/core": "^6.2.3",
    "@capacitor/ios": "^6.2.1",
    "@tailwindcss/vite": "^4.3.4",
    "@vueuse/core": "^15.0.0",
    "html5-qrcode": "^2.3.8",
    "leaflet": "^1.9.4",
    "pinia": "^4.1.0",
    "qrcode": "^1.5.4",
    "tailwindcss": "^4.3.4",
    "vite-plugin-pwa": "^2.0.0",
    "vue": "^3.5.44",
    "vue-i18n": "^11.4.18",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.3",
    "@types/google.maps": "^3.58.1",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^24.19.2",
    "@types/qrcode": "^1.5.6",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/test-utils": "^2.5.1",
    "@vue/tsconfig": "^0.9.1",
    "jsdom": "^31.0.0",
    "typescript": "~6.0.3",
    "vite": "^8.3.6",
    "vitest": "^5.1.0",
    "vue-tsc": "^3.3.14"
  }
}
